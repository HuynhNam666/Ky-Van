# Generate both with: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
BACKEND_URL=http://backend:8000
# For a separately hosted Python API, set this before frontend build:
# NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_API_URL=
# Public address of the site, used for link previews when an invitation is shared (Facebook, Zalo, Telegram...).
# NEXT_PUBLIC_SITE_URL=https://co-tuong.example.com
NEXT_PUBLIC_SITE_URL=
# How many reverse proxies in front of the API append to X-Forwarded-For (nginx/Caddy/Cloudflare in front of Next.js = 1).
# Leave 0 when nothing sits in front of the web container: the header is then ignored.
TRUSTED_PROXY_HOPS=0
# Add a TURN service for reliable calls across different networks:
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
